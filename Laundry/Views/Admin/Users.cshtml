@model IEnumerable<Laundry.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Users - BlinkIt";
}
@* jin jin logoun nai hamari website par register kiya hai woh yahan ayein gai  *@
<div id="unique-users-wrapper">
    <div class="container-fluid px-4 py-3">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="orderlist-text">Users List</h2>
                <small class="text-muted">Manage your registered customers here</small>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Account" asp-action="Register" class="pl-btn-red">
                    <i class="fas fa-user-plus me-2"></i> Add User
                </a>
                <div class="rw-stats-box">
                    <i class="fas fa-users me-2"></i> Total: @Model.Count()
                </div>
            </div>
        </div>

        <div class="card rw-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table rw-table mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Customer Name</th>
                                <th>Email Address</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@user.UserId</td>

                                    <td>
                                        <span class="fw-bold text-dark">@user.FullName</span>
                                    </td>

                                    <td>
                                        <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                    </td>

                                    <td>@(user.Contact ?? "N/A")</td>

                                    <td>
                                        <span class="small text-secondary">
                                            @(user.Address != null && user.Address.Length > 20 ? user.Address.Substring(0, 20) + "..." : user.Address ?? "Not Provided")
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="pl-btn-green"
                                                onclick="openEditModal(this)"
                                                data-id="@user.UserId"
                                                data-name="@user.FullName"
                                                data-email="@user.Email"
                                                data-phone="@(user.Contact ?? "")"
                                                data-address="@(user.Address ?? "")"
                                                title="Edit User">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="pl-btn-red"
                                                onclick="openDeleteModal('@user.UserId', '@user.FullName')"
                                                title="Delete User">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Edit Modal for user update  *@

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Edit User Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateUser" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="UserId" id="editUserId">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="FullName" id="editName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" name="Email" id="editEmail" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone</label>
                        <input type="text" name="Contact" id="editPhone" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <textarea name="Address" id="editAddress" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="pl-btn-red" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="pl-btn-green">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete User Modal  *@

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: 2px solid #d32f2f; border-radius: 10px;">
            <div class="modal-header" style="background-color: #d32f2f; color: white;">
                <h5 class="modal-title text-white"><i class="fas fa-trash-alt me-2"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-exclamation-circle fa-3x mb-3" style="color: #d32f2f;"></i>
                <p class="fs-5 mb-1">Are you sure you want to delete?</p>
                <h4 id="userNameToUpdate" style="color: #d32f2f; font-weight: 800;"></h4>
                <p class="text-muted">This record will be permanently removed.</p>
            </div>
            <div class="modal-footer" style="background-color: #f8f9fa;">
                <button type="button" class="pl-btn-green" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" asp-action="Users" class="pl-btn-red">Delete User</a>
            </div>
        </div>
    </div>
</div>

<script>
    // EDIT Modal Logic
    function openEditModal(button) {
        var id = button.getAttribute('data-id');
        var name = button.getAttribute('data-name');
        var email = button.getAttribute('data-email');
        var phone = button.getAttribute('data-phone');
        var address = button.getAttribute('data-address');

        document.getElementById('editUserId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPhone').value = phone;
        document.getElementById('editAddress').value = address;

        var editModalEl = document.getElementById('editModal');
        document.body.appendChild(editModalEl);
        var myModal = new bootstrap.Modal(editModalEl);
        myModal.show();
    }

    // DELETE Modal Logic
    function openDeleteModal(userId, userName) {
        document.getElementById('userNameToUpdate').innerText = userName;
        var deleteUrl = '/Admin/DeleteUser?id=' + userId; // Action check kar lena
        document.getElementById('confirmDeleteBtn').setAttribute('href', deleteUrl);

        var deleteModalEl = document.getElementById('deleteModal');
        document.body.appendChild(deleteModalEl);
        var myModal = new bootstrap.Modal(deleteModalEl);
        myModal.show();
    }
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>