@model IEnumerable<Laundry.Models.ServiceItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Items - BlinkIt";
}
 @* laundry item list    *@
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="orderlist-text">Laundry Items </h2>
        <a asp-action="CreateItem" class="pl-btn-red">
            <i class="fas fa-plus me-2"></i>Add New Item
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:red;color:white;">
                    <tr >
                        <th class="ps-4">Item Name</th>
                        <th>Price</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@item.ItemName</td>
                            <td class="text-danger fw-bold">  Rs. @item.Price.ToString("0")</td>
                            <td class="text-center">

                                <button type="button"
                                        class="pl-btn-green"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editItemModal"
                                        data-id="@item.ItemId"
                                        data-name="@item.ItemName"
                                        data-price="@item.Price">
                                    <i class="fas fa-edit"></i> Edit
                                </button>

                                <button type="button"
                                        class="pl-btn-red"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteItemModal"
                                        data-id="@item.ItemId">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@* edit modal *@
<div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title text-white"><i class="fas fa-edit me-2"></i>Update Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="UpdateItem" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="ItemId" id="modalEditItemId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Item Name</label>
                        <input type="text" name="ItemName" id="modalEditItemName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Price (Rs.)</label>
                        <input type="number" name="Price" id="modalEditItemPrice" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="pl-btn-red" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="pl-btn-green">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* delete modal  *@
<div class="modal fade" id="deleteItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Delete Item?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="DeleteItem" method="post">
                <div class="modal-body p-4 text-center">
                    <input type="hidden" name="id" id="modalDeleteItemId" />

                    <div class="mb-3 text-danger">
                        <i class="fas fa-trash-alt fa-3x"></i>
                    </div>
                    <h5 class="fw-bold">Are you sure?</h5>
                    <p class="text-muted">You won't be able to revert this! This item will be removed from the pricing list.</p>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="pl-btn-green" data-bs-dismiss="modal">No, Keep it</button>
                    <button type="submit" class="pl-btn-red">Yes, Delete It</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // --- 1. EDIT MODAL LOGIC ---
        var editModalEl = document.getElementById('editItemModal');
        // Modal ko Body mein move karte hain taake CSS issue na ho
        document.body.appendChild(editModalEl);

        editModalEl.addEventListener('show.bs.modal', function (event) {
            // Button jisne modal khola
            var button = event.relatedTarget;

            // Button se data nikalo
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            var price = button.getAttribute('data-price');

            // Modal ke Inputs mein data bharo
            editModalEl.querySelector('#modalEditItemId').value = id;
            editModalEl.querySelector('#modalEditItemName').value = name;
            editModalEl.querySelector('#modalEditItemPrice').value = price;
        });

        // --- 2. DELETE MODAL LOGIC ---
        var deleteModalEl = document.getElementById('deleteItemModal');
        document.body.appendChild(deleteModalEl);

        deleteModalEl.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');

            // Delete wale hidden input mein ID set karo
            deleteModalEl.querySelector('#modalDeleteItemId').value = id;
        });

    });
</script>