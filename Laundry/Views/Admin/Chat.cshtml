@model IEnumerable<Laundry.Models.UserChat>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Live Customer Chat - BlinkIt";
}

<style>
    /* Chat Layout - Fixed Height */
    .chat-container {
        height: 80vh;
        display: flex;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    /* Left Side (Sidebar) */
    .user-list-box {
        width: 320px;
        border-right: 1px solid #eee;
        background: #f9f9f9;
        display: flex;
        flex-direction: column;
    }

    .users-scroll {
        overflow-y: auto;
        flex: 1;
    }

    /* User Card Styling */
    .user-card {
        padding: 15px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .user-card:hover, .user-card.active {
            background: #fff;
            border-left: 5px solid #d32f2f; /* Red Indicator */
        }

    /* Avatar Circle */
    .avatar {
        width: 45px;
        height: 45px;
        background: #ddd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #555;
    }

    /* Right Side (Chat Area) */
    .chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .chat-header {
        padding: 15px;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .chat-history {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        background: #f4f7f6;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* Message Bubbles */
    .message-bubble {
        max-width: 75%;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 14px;
        position: relative;
        animation: fadeIn 0.3s ease;
    }

    .message-sent {
        align-self: flex-end;
        background-color: #dcf8c6; /* WhatsApp Greenish */
        color: #000;
        border-bottom-right-radius: 2px;
    }

    .timestamp {
        font-size: 10px;
        color: #666;
        text-align: right;
        margin-top: 4px;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="container-fluid py-4">
    <div class="chat-container">

        <div class="user-list-box">
            <div class="p-3 border-bottom bg-white">
                <h6 class="mb-0 fw-bold text-danger">Active Customers</h6>
            </div>

            <div class="users-scroll">
                @if (!Model.Any())
                {
                    <div class="text-center mt-5 text-muted">
                        <i class="fas fa-user-slash mb-2"></i>
                        <p class="small">No active orders found.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="user-card p-3 border-bottom position-relative"
                             style="cursor: pointer;"
                             onclick="loadUser('@item.UserId', '@item.FullName', '@item.LatestOrderId', '@item.LatestStatus', '@item.ItemSummary')">

                            <div class="w-100">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold mb-0 text-dark">@item.FullName</h6>

                                    @if (item.LatestStatus == "New" || item.LatestStatus == "Pending")
                                    {
                                        <span class="badge bg-primary rounded-pill" style="font-size: 10px;">@item.LatestStatus</span>
                                    }
                                    else if (item.LatestStatus == "Delivered" || item.LatestStatus == "Completed")
                                    {
                                        <span class="badge bg-success rounded-pill" style="font-size: 10px;">@item.LatestStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill" style="font-size: 10px;">@item.LatestStatus</span>
                                    }
                                </div>

                                <small class="text-muted fw-bold">
                                    <i class="fas fa-hashtag me-1 text-secondary"></i>Order #@item.LatestOrderId
                                </small>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="chat-area">

            <div id="emptyState" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                <i class="fas fa-comments fa-3x mb-3 text-secondary"></i>
                <p>Select a customer to view order details & chat</p>
            </div>

            <div id="activeChat" class="d-none h-100 flex-column">

                <div class="chat-header bg-dark">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar bg-danger text-white" id="headerAvatar">A</div>
                        <div>
                            <h6 class="mb-0 fw-bold text-white" id="headerName">User Name</h6>
                            <div id="headerStatus"></div>
                        </div>
                    </div>
                </div>

                <div id="chatHistory" class="chat-history">
                </div>

                <div class="p-3 bg-white border-top">

                    <div id="order-details-box" class="alert alert-info d-none mb-3 shadow-sm border-0" style="background-color: #f0f9ff; border-left: 4px solid #0dcaf0;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-shopping-basket fa-2x text-info me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark" style="font-size:14px;">Current Order Items:</h6>
                                <p class="mb-0 text-secondary" id="display-items" style="font-size: 13px;">Loading...</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 overflow-auto pb-2">
                        <button onclick="sendFakeMsg('Pending')" class="btn btn-outline-secondary btn-sm rounded-pill">Received</button>
                        <button onclick="sendFakeMsg('Processing')" class="btn btn-outline-primary btn-sm rounded-pill">Confirmed</button>
                        <button onclick="sendFakeMsg('OutForDelivery')" class="btn btn-outline-warning btn-sm rounded-pill">Out for Delivery</button>
                        <button onclick="sendFakeMsg('Completed')" class="btn btn-outline-success btn-sm rounded-pill">Delivered</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
  
    let currentName = "";
    let currentUserId = 0;
    let currentOrderId = 0;

    
    function loadUser(userId, name, orderId, status, items) {
        currentUserId = userId;
        currentName = name;
        currentOrderId = orderId;

      
        document.getElementById("headerName").innerText = name;
        document.getElementById("headerAvatar").innerText = name.charAt(0);

        let statusHtml = `<small class="text-white-50">Active Order: #${currentOrderId} (${status})</small>`;
        document.getElementById("headerStatus").innerHTML = statusHtml;

       
        document.getElementById("emptyState").classList.remove("d-flex");
        document.getElementById("emptyState").classList.add("d-none");
        document.getElementById("activeChat").classList.remove("d-none");
        document.getElementById("activeChat").classList.add("d-flex");

     
        var detailsBox = document.getElementById("order-details-box");
        var displayItems = document.getElementById("display-items");

        if (orderId && orderId != "0") {
            detailsBox.classList.remove("d-none");
            displayItems.innerText = items ? items : "No items specified";
        } else {
            detailsBox.classList.add("d-none"); 
        }

        loadChatHistory(userId);
    }

  
    function sendFakeMsg(type) {
        if(currentUserId == 0) return;

        let msg = "";
        let oidText = `Order #${currentOrderId}`;

        if (type === 'Pending') msg = `Hello ${currentName}, Thanks for choosing BlinkIt! ${oidText} is currently Pending. We will update you shortly.`;
        else if (type === 'Processing') msg = `Hi ${currentName}, update on ${oidText}: We have started Washing & Ironing your clothes! `;
        else if (type === 'OutForDelivery') msg = `Great news ${currentName}! ${oidText} is Out For Delivery. Rider is on the way. `;
        else if (type === 'Completed') msg = `As per our information your  Order  ${oidText} has been delivered. Thank you for using BlinkIt. Hope to see you again `;

        saveAndAppendMessage(msg);
    }

   
    function saveAndAppendMessage(text) {
        let date = new Date();
        let time = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        appendBubble(text, time);

        let history = JSON.parse(localStorage.getItem('chat_history_' + currentUserId)) || [];
        history.push({ text: text, time: time });
        localStorage.setItem('chat_history_' + currentUserId, JSON.stringify(history));
    }

  
    function loadChatHistory(userId) {
        let chatBox = document.getElementById("chatHistory");
        chatBox.innerHTML = "";

        let history = JSON.parse(localStorage.getItem('chat_history_' + userId)) || [];

        if (history.length === 0) {
            chatBox.innerHTML = `<div class="text-center small text-muted my-3">Send an update to start chat with ${currentName}</div>`;
        } else {
            history.forEach(msg => {
                appendBubble(msg.text, msg.time);
            });
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    }

  
    function appendBubble(text, time) {
        let historyDiv = document.getElementById("chatHistory");
        let bubble = `
            <div class="message-bubble message-sent ms-auto bg-light border text-dark" style="background:#fff !important; border-left: 4px solid #dc3545 !important;">
                ${text}
                <div class="timestamp text-muted">${time} <i class="fas fa-check-double text-danger"></i></div>
            </div>
        `;
        historyDiv.insertAdjacentHTML('beforeend', bubble);
        historyDiv.scrollTop = historyDiv.scrollHeight;
    }
</script>