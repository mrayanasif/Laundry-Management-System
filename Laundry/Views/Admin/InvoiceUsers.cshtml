@model IEnumerable<Laundry.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Invoice - BlinkIt";
}

<div class="container py-4">
    <h3 class="orderlist-text"><i class="fas fa-users me-2"></i>Select User To View His Invoice</h3>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-danger text-white">
                    <tr>
                        <th class="ps-4">Customer Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-circle p-2 me-2">
                                        <i class="fas fa-user text-danger"></i>
                                    </div>
                                    @user.FullName
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@(user.Contact ?? "N/A")</td>
                            <td class="text-center">
                                <a asp-action="UserInvoices" asp-route-id="@user.UserId" class="pl-btn-red">
                                    View Invoices <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>