<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title> @ViewData["Title"]</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="manifest" href="site.webmanifest">
    <link rel="shortcut icon" type="image/x-icon" href="~/website/img/logo/Washing-logo-up.png">

    <!-- CSS here -->    
    <link rel="stylesheet" href="~/website/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/website/css/owl.carousel.min.css">
   <link rel="stylesheet" href="~/website/css/slicknav.css" />
    <link rel="stylesheet" href="~/website/css/flaticon.css">
    <link rel="stylesheet" href="~/website/css/progressbar_barfiller.css">
    <link rel="stylesheet" href="~/website/css/gijgo.css">
    <link rel="stylesheet" href="~/website/css/animate.min.css">
    <link rel="stylesheet" href="~/website/css/animated-headline.css">
    <link rel="stylesheet" href="~/website/css/magnific-popup.css">
    <link rel="stylesheet" href="~/website/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="~/website/css/themify-icons.css">
    <link rel="stylesheet" href="~/website/css/slick.css">
    <link rel="stylesheet" href="~/website/css/nice-select.css">
    <link rel="stylesheet" href="~/website/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/website/css/site.css" asp-append-version="true" />

   
</head>
<body>
    <!-- ? Preloader Start -->
    <div id="preloader-active">
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-inner position-relative">
                <div class="preloader-circle"></div>
                <div class="preloader-img pere-text">
                    <img src="~/website/img/logo/Washing-logo-up.png" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- Preloader Start -->
            
    @* Navbar Start *@
    <header>
   
        <div class="header-area pl-header-area">
            <div class="main-header header-sticky pl-bg-white">
                <div class="container-fluid pl-container">
                    <div class="row align-items-center">

                        <div class="col-xl-2 col-lg-2">
                            <div class="logo">
                                <a asp-controller="Home" asp-action="Index" class="pl-logo-link">
                                    <div class="pl-logo-text">
                                        
                                        <img src="~/website/img/logo/Washing-logo-up.png"/>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <div class="col-xl-10 col-lg-10">
                            <div class="menu-wrapper d-flex align-items-center justify-content-between">

                                <div class="main-menu d-none d-lg-block">
                                    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
                                        <ul id="navigation" class="d-flex align-items-center pl-nav-ul">
                                            <li><a class="pl-nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                                            <li><a class="pl-nav-link" asp-controller="Home" asp-action="AboutUs">About Us </a></li>
                                            <li><a class="pl-nav-link" asp-controller="Home" asp-action="Service">Services</a></li>
                                            <li><a class="pl-nav-link" asp-controller="Orders" asp-action="Create">Prices</a></li>
                                            <li><a class="pl-nav-link"asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                                            <li><a class="pl-nav-link" asp-controller="Orders" asp-action="MyOrders">Invoice</a></li>
                                           
                                        </ul>
                                    </nav>
                                </div>

                                <div class="pl-header-right d-none d-lg-flex align-items-center">
                                    <div class="pl-login-wrapper me-3">
                                        <partial name="_LoginPartial" />
                                    </div>




                                    <a href="https://wa.link/oiiaxf" target="_blank" class="pl-btn-red">Connect with Us</a>

                                </div>

                            </div>
                        </div>

                        <div class="col-12">
                            <div class="mobile_menu d-block d-lg-none"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>
    @* Navbar End *@
    
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

@* <footer> Start*@
    <footer class="pl-footer-section">
        <div class="pl-bubbles">
            <span style="--i:11;"></span>
            <span style="--i:12;"></span>
            <span style="--i:24;"></span>
            <span style="--i:10;"></span>
            <span style="--i:14;"></span>
            <span style="--i:23;"></span>
            <span style="--i:18;"></span>
            <span style="--i:16;"></span>
            <span style="--i:19;"></span>
            <span style="--i:20;"></span>
        </div>

        <div class="container">
            <div class="row">

                <div class="col-xl-4 col-lg-4 col-md-6 mb-50">
                    <div class="pl-footer-widget">
                        <div class="pl-footer-logo mb-30">
                            <a asp-controller="Home" asp-action="Index" class="pl-logo-text-white">
                                <i class="fa-solid fa-soap pl-text-red"></i> Blink<span class="pl-text-red">It</span>
                            </a>
                        </div>
                        <div class="pl-footer-text">
                            <p>We are professionals in the laundry and dry cleaning business, which means we always stay up to date on the latest technologies and cleaning methods.</p>
                        </div>
                        <div class="pl-footer-social">
                            <a href="https://www.twitter.com"><i class="fa-brands fa-twitter"></i></a>
                            <a href="https://www.facebook.com"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="https://www.youtube.com"><i class="fa-brands fa-youtube"></i></a>
                            <a href="https://www.instagram.com"><i class="fa-brands fa-instagram"></i></a>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 mb-50">
                    <div class="pl-footer-widget">
                        <h4 class="pl-footer-title">Contacts</h4>
                        <ul class="pl-contact-list">
                           
                            <li>
                                <i class="fa-regular fa-clock pl-text-red"></i>
                                <span>Mon-Fri: 8am - 6pm <br> Sat-Sun: 10am - 5pm</span>
                            </li>
                            <li>
                                <i class="fa-regular fa-envelope pl-text-red"></i>
                                <span>blinkit@gmail.com</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-phone-volume pl-text-red"></i>
                                <span>021 (354) 25-1-211</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 mb-50">
                    <div class="pl-footer-widget">
                        <h4 class="pl-footer-title">Newsletter Subscribe</h4>
                        <div class="pl-footer-text mb-30">
                            <p>Sign up and receive our special offers.</p>
                        </div>
                        <form action="#" class="pl-subscribe-form">
                            <input type="email" placeholder="Your e-mail address">
                            <button type="button">Subscribe Now</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        <div class="pl-copyright-area">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="text-center ">
                            <p>Copyright &copy; 2026 All rights reserved | BlinkIt Laundry</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>      
    </footer>
    @* footer End*@

    <!-- Scroll Up -->  
    <div id="back-top" >
        <a title="Go to Top" href="#" > <i class="fas fa-level-up-alt "></i></a>
    </div>

    <!-- JS here -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/website/js/vendor/modernizr-3.5.0.min.js"></script>
    <!-- Jquery, Popper, Bootstrap -->
    <script src="~/website/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/website/js/popper.min.js"></script>
    <script src="~/website/js/bootstrap.min.js"></script>
    <!-- Jquery Mobile Menu -->
    <script src="~/website/js/jquery.slicknav.min.js"></script>

    <!-- Jquery Slick , Owl-Carousel Plugins -->
    <script src="~/website/js/owl.carousel.min.js"></script>
    <script src="~/website/js/slick.min.js"></script>
    <!-- One Page, Animated-HeadLin -->
    <script src="~/website/js/wow.min.js"></script>
    <script src="~/website/js/animated.headline.js"></script>
    <script src="~/website/js/jquery.magnific-popup.js"></script>

    <!-- Date Picker -->
    <script src="~/website/js/gijgo.min.js"></script>
    <!-- Nice-select, sticky -->
    <script src="~/website/js/jquery.nice-select.min.js"></script>
    <script src="~/website/js/jquery.sticky.js"></script>
    <!-- Progress -->
    <script src="~/website/js/jquery.barfiller.js"></script>

    <!-- counter , waypoint,Hover Direction -->
    <script src="~/website/js/jquery.counterup.min.js"></script>
    <script src="~/website/js/waypoints.min.js"></script>
    <script src="~/website/js/jquery.countdown.min.js"></script>
    <script src="~/website/js/hover-direction-snake.min.js"></script>

    <!-- contact js -->
    <script src="~/website/js/contact.js"></script>
    <script src="~/website/js/jquery.form.js"></script>
    <script src="~/website/js/jquery.validate.min.js"></script>
    <script src="~/website/js/mail-script.js"></script>
    <script src="~/website/js/jquery.ajaxchimp.min.js"></script>

    <!-- Jquery Plugins, main Jquery -->
    <script src="~/website/js/plugins.js"></script>
    <script src="~/website/js/main.js"></script>
    <script>
        document.querySelectorAll('.pl-nav-link').forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('pl-active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
