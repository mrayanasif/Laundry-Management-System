@{
    ViewData["Title"] = "FAQ Page  - Blink It";
}
<!--? Hero Start -->
    <div class="ab-hero-section">

        <img src="~/website/img/hero/hero-about-us.jpg" alt="Background" class="ab-bg-img">

        <div class="ab-dark-overlay"></div>

        <div class="ab-hero-bubbles">
            <span style="--i:11;"></span>
            <span style="--i:12;"></span>
            <span style="--i:24;"></span>
            <span style="--i:10;"></span>
            <span style="--i:14;"></span>
            <span style="--i:23;"></span>
            <span style="--i:18;"></span>     
        </div>

        <div class="container ab-content-layer">
            <div class="row">
                <div class="col-xl-12">
                    <div class="ab-hero-text">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb justify-content-center bg-transparent p-0 m-0">
                                <li class="breadcrumb-item"><a asp-action="Index">home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">FAQ</li>
                            </ol>
                        </nav>

                        <h2>Frequently Asked Question</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
<!-- Hero End -->

@* FAQ *@
<section class="faq-area section-padding40">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-9">
                <div class="section-tittle text-center mb-55">
                    <span class="element">[ Frequently Asked Questions ]</span>
                    <h2>Reliable Answers to Our Most Common Questions</h2>
                    <p class="mt-3 text-muted">We can save your money on soap, water, heating and electricity. So you can enjoy even more of the things you love.</p>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <h4 class="faq-category-title">Your First Order!</h4>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="accordion pl-accordion" id="accordionFirstOrderLeft">

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                What should I prepare for the first pickup?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFirstOrderLeft">
                            <div class="accordion-body">
                                We aim to collect your clothes, clean them to a professional standard and get them back to you all within 48 hours. If you prefer we went a little slower, just let us know.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                Can I add extra items to my order when you collect?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionFirstOrderLeft">
                            <div class="accordion-body">
                                Yes, absolutely! Just hand them to the driver and mention the extra items. We will update your order accordingly.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                Can I order by phone or email?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionFirstOrderLeft">
                            <div class="accordion-body">
                                Yes, you can call our hotline or email support to schedule a pickup if you prefer not to use the website.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="accordion pl-accordion" id="accordionFirstOrderRight">

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                Why do some fabrics cost more to clean than others?
                            </button>
                        </h2>
                        <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#accordionFirstOrderRight">
                            <div class="accordion-body">
                                Certain delicate fabrics like Silk, Wool, or Linen require specialized cleaning agents and slower drying processes to maintain their texture and prevent shrinkage.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingFive">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                                Are there any fabrics you don't clean?
                            </button>
                        </h2>
                        <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#accordionFirstOrderRight">
                            <div class="accordion-body">
                                We handle almost all fabrics, but we may decline items that are damaged beyond repair or require hazardous solvents we do not use.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingSix">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                                What if my clothes are heavily stained?
                            </button>
                        </h2>
                        <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#accordionFirstOrderRight">
                            <div class="accordion-body">
                                Please let us know about heavy stains beforehand so we can apply special pre-treatment to ensure the best results.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="row mt-5">

            <div class="col-lg-6">
                <h4 class="faq-category-title">Dry Cleaning</h4>
                <div class="accordion pl-accordion" id="accordionDryClean">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingSeven">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSeven">
                                What if my clothes are damaged?
                            </button>
                        </h2>
                        <div id="collapseSeven" class="accordion-collapse collapse" data-bs-parent="#accordionDryClean">
                            <div class="accordion-body">
                                In the rare event of damage, our team will investigate immediately. We are fully insured and adhere to industry compensation standards.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <h4 class="faq-category-title">Wash, Tumble Dry & Fold</h4>
                <div class="accordion pl-accordion" id="accordionWashFold">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingEight">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEight">
                                Do I need to weigh my Wash & Fold bag?
                            </button>
                        </h2>
                        <div id="collapseEight" class="accordion-collapse collapse" data-bs-parent="#accordionWashFold">
                            <div class="accordion-body">
                                No, you don't need to weigh it. Our driver will weigh it upon collection or we will weigh it at our facility using certified scales.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

    


@* Team *@
<section class="team-area section-padding40">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-7 col-lg-8">
                <div class="section-tittle text-center mb-55">
                    <span class="element">[ Our Team ]</span>
                    <h2>Laundry Specialists</h2>
                    <p class="mt-3" style="color: #666; font-size: 16px;">
                        Our team’s goal each day is to earn your business with each visit and to make your experience with us the absolute best.
                    </p>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="single-team mb-30 text-center">
                    <div class="team-img">
                        <img src="~/website/img/gallery/man1.png" alt="Charles Rock">
                    </div>
                    <div class="team-caption">
                        <h3>Zain Ali</h3>
                        <p>Operations Manager</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="single-team mb-30 text-center">
                    <div class="team-img">
                        <img src="~/website/img/gallery/team-2.jpg" alt="Justin Stein">
                    </div>
                    <div class="team-caption">
                        <h3>Maaz Faisal</h3>
                        <p>Service Manager</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="single-team mb-30 text-center">
                    <div class="team-img">
                        <img src="~/website/img/hero/manprof.jpg" alt="Amy Hellickson">
                    </div>
                    <div class="team-caption">
                        <h3>Raza Mir</h3>
                        <p>Wash Expert</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
@* Team *@