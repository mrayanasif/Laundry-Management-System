    <style>

        .carousel-item {
            height: 100vh;
            background-color: #000;
            position: relative;
        }

            .carousel-item img {
                height: 100%;
                width: 100%;
                object-fit: cover;
                opacity: 0.8; 
            }

     
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1;
        }

       
        .carousel-caption {
            top: 50%;
            transform: translateY(-50%);
            bottom: initial;
            z-index: 2;
            text-align: left; 
            left: 10%;
            right: 10%;
        }

      
        .btn-custom {
            background-color: red;
            border-color: white;
            color: white;
            padding: 12px 35px;
            font-size: 2.2rem;
            border-radius: 50px;
            transition: all 0.3s;
            text-decoration:none;   
        }

            .btn-custom:hover {
                background-color: white;
                color: darkred  ;
            }

        
        

        .carousel-item h1,
        .carousel-item p,
        .carousel-item .btn {
            opacity: 0; 
        }

       
        .carousel-item.active h1 {
            animation: slideDown 1s ease-out forwards;
            animation-delay: 0.2s;
        }

      
        .carousel-item.active p {
            animation: slideUp 1s ease-out forwards;
            animation-delay: 0.6s;
            color: white;
            font-size:20px;
        }

     
        .carousel-item.active .btn {
            animation: fadeIn 1s ease-out forwards;
            animation-delay: 0.9s;
        }

        @@keyframes slideDown {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @@keyframes slideUp {
            from {
                transform: translateY(50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
       

        
    </style>
        <!--? slider Area Start-->
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">

